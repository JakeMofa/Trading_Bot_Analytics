# TRADEBOT ANALYTICS / BTC INTELLIGENCE
# Example only. Never commit real credentials.

# Local SQLite
SQLITE_DB_PATH=data/btc_intelligence.db

# Polymarket read-only market WebSocket
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Optional OpenAI analyst. Paid calls stay OFF unless explicitly enabled.
OPENAI_API_KEY=
ENABLE_OPENAI_ANALYST=false
OPENAI_ANALYST_MIN_INTERVAL_SECONDS=60
AI_MODEL=

# Supabase / PostgreSQL
SUPABASE_PROJECT_REF=xttdqeimdujweijxcuro
SUPABASE_URL=https://xttdqeimdujweijxcuro.supabase.co
SUPABASE_DB_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://xttdqeimdujweijxcuro.supabase.co/auth/v1/.well-known/jwks.json

# Supabase sync. Keep disabled until the storage phase is implemented and tested.
ENABLE_SUPABASE_SYNC=false
SUPABASE_SYNC_BATCH_SIZE=100
SUPABASE_SYNC_INTERVAL_SECONDS=30

# FastAPI service layer
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_RELOAD=false

# Live analysis
FORECAST_INTERVAL_SECONDS=3
REST_INTERVAL_SECONDS=30

# Specialist feature flags
ENABLE_MICROSTRUCTURE=false
ENABLE_CROSS_EXCHANGE=false
ENABLE_DERIVATIVES=false
ENABLE_HISTORICAL_V2=false
ENABLE_META_MODEL=false

# Local storage safety
MAX_LOCAL_STORAGE_MB=2048
