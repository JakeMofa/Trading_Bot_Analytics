[Unit]
Description=Tradebot read-only API and sole market collector
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=tradebot
Group=tradebot
WorkingDirectory=/opt/tradebot
EnvironmentFile=/opt/tradebot/.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/tradebot/.venv/bin/python deploy/lightsail/preflight.py
ExecStart=/usr/bin/env ENABLE_OPENAI_ANALYST=false ENABLE_LOCAL_RETENTION=false FASTAPI_HOST=127.0.0.1 FASTAPI_RELOAD=false /opt/tradebot/.venv/bin/python backend/app/run_api.py
Restart=always
RestartSec=10
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/tradebot/data
UMask=0077

[Install]
WantedBy=multi-user.target
