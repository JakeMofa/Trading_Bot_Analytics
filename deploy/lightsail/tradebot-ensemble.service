[Unit]
Description=Tradebot experimental numerical ensemble (OpenAI disabled)
Wants=network-online.target tradebot-api.service
After=network-online.target tradebot-api.service tradebot-lifecycle.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=tradebot
Group=tradebot
WorkingDirectory=/opt/tradebot
EnvironmentFile=/opt/tradebot/.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/tradebot/.venv/bin/python deploy/lightsail/preflight.py
ExecStart=/usr/bin/env ENABLE_OPENAI_ANALYST=false ENABLE_LOCAL_RETENTION=false /opt/tradebot/.venv/bin/python backend/app/run_ensemble_agent.py --db data/btc_intelligence.db
Restart=always
RestartSec=10
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/tradebot/data
UMask=0077

[Install]
WantedBy=multi-user.target
