-- Review only. Substitute separately verified canonical Auth UIDs before use.
-- No default-branch migration, Auth user, object or existing policy is modified.
BEGIN;
DO $preflight$
BEGIN
  IF '__PP_HISTORY_READER_UID__'::uuid = '__PP_STORAGE_AUTH_UID__'::uuid
     OR NOT EXISTS (SELECT FROM auth.users WHERE id='__PP_HISTORY_READER_UID__'::uuid
       AND role='authenticated' AND email_confirmed_at IS NOT NULL
       AND raw_app_meta_data->>'tradebot_role'='pp_storage_history_reader'
       AND raw_app_meta_data->>'tradebot_origin'='pp-live-pp')
     OR NOT EXISTS (SELECT FROM auth.users WHERE id='__PP_STORAGE_AUTH_UID__'::uuid
       AND role='authenticated' AND raw_app_meta_data->>'tradebot_role'='pp_storage_archive'
       AND raw_app_meta_data->>'tradebot_origin'='pp-live-pp')
     OR NOT EXISTS (SELECT FROM storage.buckets WHERE id='market-raw' AND NOT public)
     OR NOT EXISTS (SELECT FROM pg_class WHERE oid='storage.objects'::regclass AND relrowsecurity)
     OR NOT EXISTS (SELECT FROM pg_policies WHERE schemaname='storage' AND tablename='objects'
       AND policyname='tradebot_pp_raw_readback' AND cmd='SELECT'
       AND qual LIKE '%__PP_STORAGE_AUTH_UID__%')
     OR NOT EXISTS (SELECT FROM pg_policies WHERE schemaname='storage' AND tablename='objects'
       AND policyname='tradebot_pp_raw_upload' AND cmd='INSERT'
       AND with_check LIKE '%__PP_STORAGE_AUTH_UID__%') THEN
    RAISE EXCEPTION 'PP Storage reader identity/policy changed';
  END IF;
END $preflight$;

CREATE POLICY tradebot_pp_history_reader_select ON storage.objects FOR SELECT TO authenticated
  USING (auth.uid()='__PP_HISTORY_READER_UID__'::uuid);
CREATE POLICY tradebot_pp_history_reader_exact_get ON storage.objects AS RESTRICTIVE FOR SELECT TO authenticated
  USING (auth.uid() IS DISTINCT FROM '__PP_HISTORY_READER_UID__'::uuid OR (
    bucket_id='market-raw'
    AND name ~ '^raw-v1/6157f7800b12255ab48111b5c6258a444712a38baca54d3b0929ede8994b2ae8/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{64}[.]jsonl[.]gz$'
    AND storage.allow_any_operation(ARRAY['storage.object.get_authenticated','object.get_authenticated_info'])));
CREATE POLICY tradebot_pp_history_reader_deny_insert ON storage.objects AS RESTRICTIVE FOR INSERT TO authenticated
  WITH CHECK (auth.uid() IS DISTINCT FROM '__PP_HISTORY_READER_UID__'::uuid);
CREATE POLICY tradebot_pp_history_reader_deny_update ON storage.objects AS RESTRICTIVE FOR UPDATE TO authenticated
  USING (auth.uid() IS DISTINCT FROM '__PP_HISTORY_READER_UID__'::uuid)
  WITH CHECK (auth.uid() IS DISTINCT FROM '__PP_HISTORY_READER_UID__'::uuid);
CREATE POLICY tradebot_pp_history_reader_deny_delete ON storage.objects AS RESTRICTIVE FOR DELETE TO authenticated
  USING (auth.uid() IS DISTINCT FROM '__PP_HISTORY_READER_UID__'::uuid);
COMMIT;
