-- REVIEW TEMPLATE ONLY. Replace markers through the pinned renderer.
-- Amend only the existing PP readback policy after an exact live catalog hash.
BEGIN;
DO $preflight$
DECLARE
  actual_policy_sha256 text;
BEGIN
  IF '__PP_STORAGE_AUTH_UID__' !~
      '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' OR
     '__EXPECTED_POLICY_SHA256__' !~ '^[0-9a-f]{64}$' THEN
    RAISE EXCEPTION 'reviewed PP Storage UID and policy hash required';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM auth.users
                 WHERE id='__PP_STORAGE_AUTH_UID__'::uuid
                   AND email='__PP_STORAGE_AUTH_EMAIL__'
                   AND role='authenticated'
                   AND email_confirmed_at IS NOT NULL
                   AND raw_app_meta_data->>'tradebot_role'='pp_storage_archive'
                   AND raw_app_meta_data->>'tradebot_origin'='pp-live-pp') THEN
    RAISE EXCEPTION 'reviewed PP Storage Auth identity binding changed';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM storage.buckets
                 WHERE id='market-raw' AND public=false) THEN
    RAISE EXCEPTION 'private market-raw bucket binding changed';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
                 WHERE n.nspname='storage' AND c.relname='objects' AND c.relrowsecurity) THEN
    RAISE EXCEPTION 'Storage objects RLS is not enabled';
  END IF;
  IF to_regprocedure('storage.allow_any_operation(text[])') IS NULL THEN
    RAISE EXCEPTION 'Storage operation helper changed';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM storage.objects
                 WHERE bucket_id='market-raw'
                   AND owner_id='__PP_STORAGE_AUTH_UID__'
                   AND name='raw-v1/6157f7800b12255ab48111b5c6258a444712a38baca54d3b0929ede8994b2ae8/500b0871-6f59-46de-a17c-537f6b0aee5d/5589f047e23adedca048ccadb7351f5d6eefb82b55314fdb3676d4a01096b7bf.jsonl.gz') THEN
    RAISE EXCEPTION 'retained PP synthetic object binding changed';
  END IF;
  IF (SELECT count(*) FROM pg_policies
      WHERE schemaname='storage' AND tablename='objects')<>2 OR
     NOT EXISTS (SELECT 1 FROM pg_policies WHERE schemaname='storage'
                 AND tablename='objects' AND policyname='tradebot_pp_raw_upload'
                 AND cmd='INSERT' AND roles::text[]=ARRAY['authenticated']::text[]
                 AND with_check LIKE '%__PP_STORAGE_AUTH_UID__%'
                 AND with_check LIKE '%market-raw%'
                 AND with_check LIKE '%6157f7800b12255ab48111b5c6258a444712a38baca54d3b0929ede8994b2ae8%'
                 AND with_check LIKE '%storage.object.upload%') OR
     NOT EXISTS (SELECT 1 FROM pg_policies WHERE schemaname='storage'
                 AND tablename='objects' AND policyname='tradebot_pp_raw_readback'
                 AND cmd='SELECT' AND roles::text[]=ARRAY['authenticated']::text[]
                 AND qual LIKE '%__PP_STORAGE_AUTH_UID__%'
                 AND qual LIKE '%market-raw%'
                 AND qual LIKE '%6157f7800b12255ab48111b5c6258a444712a38baca54d3b0929ede8994b2ae8%'
                 AND qual LIKE '%storage.object.get_authenticated%'
                 AND qual NOT LIKE '%object.get_authenticated_info%') THEN
    RAISE EXCEPTION 'reviewed PP Storage policy set changed';
  END IF;
  SELECT encode(sha256(convert_to(jsonb_agg(to_jsonb(p) ORDER BY p.policyname)::text,
                                  'UTF8')),'hex') INTO actual_policy_sha256
    FROM pg_policies p WHERE p.schemaname='storage' AND p.tablename='objects';
  IF actual_policy_sha256<>'__EXPECTED_POLICY_SHA256__' THEN
    RAISE EXCEPTION 'PP Storage policy catalog hash changed';
  END IF;
END $preflight$;

-- No upload-policy, object, bucket, Auth-user or data mutation.
ALTER POLICY tradebot_pp_raw_readback ON storage.objects
  USING (
    auth.uid() = '__PP_STORAGE_AUTH_UID__'::uuid
    AND bucket_id = 'market-raw'
    AND name ~ '^raw-v1/6157f7800b12255ab48111b5c6258a444712a38baca54d3b0929ede8994b2ae8/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{64}[.]jsonl[.]gz$'
    AND storage.allow_any_operation(ARRAY[
      'storage.object.get_authenticated','object.get_authenticated_info']));
COMMIT;
